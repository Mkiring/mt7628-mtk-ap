--- a/embedded/os/linux/rt_linux.c
+++ b/embedded/os/linux/rt_linux.c
@@ -50,6 +50,17 @@
 #include "dot11i_wpa.h"
 #include <linux/rtnetlink.h>

+/* Linux 5.4 compatibility - timer API changed in 4.15+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 15, 0)
+/* In kernel 4.15+, init_timer/setup_timer were removed
+ * Use timer_setup() instead
+ * Timer callback signature changed from:
+ *   void callback(unsigned long data)
+ * to:
+ *   void callback(struct timer_list *timer)
+ */
+#define init_timer(timer) timer_setup(timer, NULL, 0)
+#endif
+
 #if defined(CONFIG_RA_HW_NAT) || defined(CONFIG_RA_HW_NAT_MODULE)
 #if defined(CONFIG_SUPPORT_OPENWRT)
 #include "../../../linux-kernel/net/nat/hw_nat/ra_nat.h"
--- a/embedded/include/os/rt_linux.h
+++ b/embedded/include/os/rt_linux.h
@@ -632,6 +632,15 @@ typedef struct tasklet_struct OS_TASKLET;
 typedef struct timer_list	OS_NDIS_MINIPORT_TIMER;
 typedef struct timer_list	OS_TIMER;

+/* Linux 5.4 compatibility */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 15, 0)
+/* Helper macro to get data from timer callback */
+#define from_timer(var, callback_timer, timer_fieldname) \
+	container_of(callback_timer, typeof(*var), timer_fieldname)
+
+/* Timer data field removed in 4.15+ */
+#define timer_data_field(timer) (0)
+#endif
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,27)
 #include <linux/pid.h>
 #endif
--- a/embedded/os/linux/rt_linux.c
+++ b/embedded/os/linux/rt_linux.c
@@ -220,11 +231,20 @@ static inline VOID __RTMP_OS_Init_Timer(
 	IN PVOID data)
 {
 	if (!timer_pending(pTimer)) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 15, 0)
+		/* For kernel 4.15+, we need to use timer_setup
+		 * But we need to preserve backward compatibility
+		 * The callback wrapper will be handled elsewhere
+		 */
+		timer_setup(pTimer, (void (*)(struct timer_list *))function, 0);
+		/* Note: 'data' parameter is ignored in new API, stored via from_timer() */
+#else
 		init_timer(pTimer);
 		pTimer->data = (unsigned long)data;
 		pTimer->function = function;
+#endif
 	}
 }

