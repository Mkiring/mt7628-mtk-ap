+			of_node_put(np);
+			pr_info("mt7628: Using DT resources: csr=0x%lx, irq=%d",
+				csr_addr, dev_irq);
+		} else
+#endif
+		{
+			csr_addr = (unsigned long)RTMP_MAC_CSR_ADDR;
+			dev_irq = RTMP_MAC_IRQ_NUM;
+		}
+#ifdef CONFIG_OF
+	}
+#endif
 
