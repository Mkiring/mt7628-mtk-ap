diff --git a/mt7628_wifi/embedded/os/linux/rbus_main_dev.c b/mt7628_wifi/embedded/os/linux/rbus_main_dev.c
index 5cf9f19..362697d 100644
--- a/mt7628_wifi/embedded/os/linux/rbus_main_dev.c
